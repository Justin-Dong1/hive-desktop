{
  "name": "glass-hive-desktop",
  "version": "1.1.2",
  "private": true,
  "description": "Hive Desktop for Windows 11, with optional Wallpaper Engine integration",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js",
    "prepare:release": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File tools/prepare-release.ps1",
    "pack": "pnpm run prepare:release && electron-builder --dir --win --x64 --publish never",
    "dist": "pnpm run prepare:release && electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "26.15.3"
  }
}
